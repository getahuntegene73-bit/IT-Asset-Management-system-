<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Asset | IT Asset Management</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f3f4f6;
            color: #111827;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: #111827;
            color: white;
            padding: 20px 15px;
        }

        .company-logo {
            text-align: center;
            margin-bottom: 15px;
        }

        .company-logo img {
            width: 170px;
            height: 70px;
            object-fit: contain;
            background: white;
            border-radius: 6px;
        }

        .system-title {
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .menu-title {
            color: #9ca3af;
            font-size: 12px;
            margin: 20px 10px 10px;
            text-transform: uppercase;
        }

        .sidebar a {
            display: block;
            color: #d1d5db;
            text-decoration: none;
            padding: 12px 14px;
            margin-bottom: 5px;
            border-radius: 7px;
            font-size: 14px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #2563eb;
            color: white;
        }

        .main {
            margin-left: 250px;
            padding: 25px;
        }

        .topbar {
            margin-bottom: 25px;
        }

        .topbar h1 {
            font-size: 28px;
        }

        .topbar p {
            color: #6b7280;
            margin-top: 5px;
        }

        .form-container {
            max-width: 900px;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        label {
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: bold;
        }

        input,
        select,
        textarea {
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .buttons {
            margin-top: 25px;
            display: flex;
            gap: 10px;
        }

        button,
        .cancel {
            padding: 12px 20px;
            border-radius: 7px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            text-decoration: none;
        }

        button {
            background: #2563eb;
            color: white;
        }

        button:hover {
            background: #1d4ed8;
        }

        .cancel {
            background: #e5e7eb;
            color: #111827;
        }

        .message {
            margin-top: 20px;
            padding: 12px;
            border-radius: 6px;
            display: none;
        }

        .success {
            display: block;
            background: #dcfce7;
            color: #166534;
        }

        .error {
            display: block;
            background: #fee2e2;
            color: #991b1b;
        }

        @media (max-width: 800px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }
        }
    </style>
</head>

<body>

<div class="sidebar">

    <div class="company-logo">
        <img src="assets/logo.jpg" alt="Elsewedy Cables Logo">
    </div>

    <div class="system-title">
        IT Asset Manager
    </div>

    <div class="menu-title">Main Menu</div>

    <a href="index.html">📊 Dashboard</a>
    <a href="assets.html">💻 Assets</a>
    <a href="employees.html">👥 Employees</a>
    <a href="#">🔄 Assignments</a>
    <a href="#">🔧 Maintenance</a>
    <a href="#">📈 Reports</a>

    <div class="menu-title">System</div>

    <a href="#">⚙️ Settings</a>

</div>


<div class="main">

    <div class="topbar">
        <h1>Add New Asset</h1>
        <p>Register a new company IT asset.</p>
    </div>


    <div class="form-container">

        <form id="assetForm">

            <div class="form-grid">

                <div class="form-group">
                    <label>Asset ID *</label>
                    <input type="text" id="assetId" required placeholder="Example: PC-100">
                </div>

                <div class="form-group">
                    <label>Equipment Name *</label>
                    <input type="text" id="equipment" required placeholder="Example: Dell OptiPlex 7010">
                </div>

                <div class="form-group">
                    <label>Category</label>
                    <select id="category">
                        <option>Computer</option>
                        <option>Laptop</option>
                        <option>Printer</option>
                        <option>Network Equipment</option>
                        <option>CCTV</option>
                        <option>Server</option>
                        <option>UPS</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Serial Number *</label>
                    <input type="text" id="serial" required placeholder="Serial number">
                </div>

                <div class="form-group">
                    <label>Department</label>
                    <select id="department">
                        <option>IT</option>
                        <option>Finance</option>
                        <option>HR</option>
                        <option>Production</option>
                        <option>Purchasing</option>
                        <option>Quality</option>
                        <option>Management</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select id="status">
                        <option>Available</option>
                        <option>In Use</option>
                        <option>Repair</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Location</label>
                    <input type="text" id="location" placeholder="Example: Factory">
                </div>

                <div class="form-group">
                    <label>Purchase Date</label>
                    <input type="date" id="purchaseDate">
                </div>

                <div class="form-group full">
                    <label>Notes</label>
                    <textarea id="notes" placeholder="Additional information..."></textarea>
                </div>

            </div>


            <div class="buttons">

                <a href="assets.html" class="cancel">
                    Cancel
                </a>

                <button type="submit">
                    Save Asset
                </button>

            </div>


            <div id="message" class="message"></div>

        </form>

    </div>

</div>


<script>

document.getElementById("assetForm").addEventListener("submit", function(event) {

    event.preventDefault();


    const asset = {

        id: document.getElementById("assetId").value.trim(),

        equipment: document.getElementById("equipment").value.trim(),

        category: document.getElementById("category").value,

        serial: document.getElementById("serial").value.trim(),

        department: document.getElementById("department").value,

        status: document.getElementById("status").value,

        location: document.getElementById("location").value.trim(),

        purchaseDate: document.getElementById("purchaseDate").value,

        notes: document.getElementById("notes").value.trim()

    };


    let assets =
        JSON.parse(localStorage.getItem("assets")) || [];


    const duplicate = assets.some(
        item => item.id.toLowerCase() === asset.id.toLowerCase()
    );


    const message = document.getElementById("message");


    if (duplicate) {

        message.className = "message error";

        message.textContent =
            "This Asset ID already exists.";

        return;
    }


    assets.push(asset);


    localStorage.setItem(
        "assets",
        JSON.stringify(assets)
    );


    message.className = "message success";

    message.textContent =
        "Asset saved successfully!";


    document.getElementById("assetForm").reset();


    setTimeout(function() {

        window.location.href = "assets.html";

    }, 1200);

});

</script>

</body>
</html>
