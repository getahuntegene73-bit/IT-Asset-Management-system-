<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Add Asset | IT Asset Management</title>


<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
    }


    body {
        background: #f4f7fb;
        color: #1e293b;
    }


    /* ================= SIDEBAR ================= */

    .sidebar {

        position: fixed;

        left: 0;
        top: 0;

        width: 250px;
        height: 100vh;

        background: #111827;

        color: white;

        padding: 25px 15px;

        z-index: 1000;
    }


    .logo {

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 0 12px 30px;

        border-bottom: 1px solid #374151;
    }


    .logo-icon {

        width: 42px;
        height: 42px;

        border-radius: 10px;

        background: #2563eb;

        display: flex;

        justify-content: center;
        align-items: center;

        font-size: 20px;

        font-weight: bold;
    }


    .logo h2 {
        font-size: 17px;
    }


    .logo span {

        display: block;

        color: #9ca3af;

        font-size: 11px;

        margin-top: 3px;
    }


    .menu {
        margin-top: 25px;
    }


    .menu-title {

        color: #6b7280;

        font-size: 11px;

        text-transform: uppercase;

        margin: 0 12px 10px;

        letter-spacing: 1px;
    }


    .menu a {

        display: flex;

        align-items: center;

        gap: 13px;

        color: #cbd5e1;

        text-decoration: none;

        padding: 13px 12px;

        margin-bottom: 5px;

        border-radius: 8px;

        font-size: 14px;

        transition: 0.2s;
    }


    .menu a:hover,
    .menu a.active {

        background: #2563eb;

        color: white;
    }


    .menu-icon {

        width: 20px;

        text-align: center;
    }


    /* ================= MAIN ================= */

    .main {

        margin-left: 250px;

        min-height: 100vh;
    }


    /* ================= TOPBAR ================= */

    .topbar {

        height: 75px;

        background: white;

        border-bottom: 1px solid #e5e7eb;

        display: flex;

        justify-content: space-between;

        align-items: center;

        padding: 0 30px;
    }


    .topbar h1 {

        font-size: 21px;

        color: #111827;
    }


    .topbar p {

        color: #64748b;

        font-size: 13px;

        margin-top: 4px;
    }


    .profile {

        display: flex;

        align-items: center;

        gap: 12px;
    }


    .profile-avatar {

        width: 40px;
        height: 40px;

        background: #dbeafe;

        color: #1d4ed8;

        border-radius: 50%;

        display: flex;

        align-items: center;
        justify-content: center;

        font-weight: bold;
    }


    .profile-info strong {

        display: block;

        font-size: 13px;
    }


    .profile-info span {

        color: #64748b;

        font-size: 11px;
    }


    /* ================= CONTENT ================= */

    .content {

        padding: 30px;

        max-width: 1100px;
    }


    .page-header {

        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 25px;
    }


    .page-header h2 {

        font-size: 24px;

        color: #111827;
    }


    .page-header p {

        color: #64748b;

        margin-top: 6px;

        font-size: 13px;
    }


    /* ================= FORM ================= */

    .form-panel {

        background: white;

        border: 1px solid #e5e7eb;

        border-radius: 12px;

        padding: 25px;
    }


    .form-title {

        font-size: 17px;

        margin-bottom: 22px;

        color: #111827;
    }


    .form-grid {

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 20px;
    }


    .form-group {

        display: flex;

        flex-direction: column;
    }


    .form-group.full {

        grid-column: 1 / -1;
    }


    label {

        font-size: 12px;

        font-weight: bold;

        color: #334155;

        margin-bottom: 7px;
    }


    input,
    select,
    textarea {

        width: 100%;

        padding: 12px;

        border: 1px solid #dbe1e8;

        border-radius: 7px;

        outline: none;

        font-size: 13px;

        background: white;
    }


    input:focus,
    select:focus,
    textarea:focus {

        border-color: #2563eb;

        box-shadow: 0 0 0 2px rgba(37,99,235,0.08);
    }


    textarea {

        min-height: 110px;

        resize: vertical;
    }


    .required {

        color: #dc2626;
    }


    /* ================= BUTTONS ================= */

    .form-actions {

        display: flex;

        justify-content: flex-end;

        gap: 12px;

        margin-top: 25px;

        padding-top: 20px;

        border-top: 1px solid #eef2f7;
    }


    .btn {

        border: none;

        padding: 12px 22px;

        border-radius: 7px;

        cursor: pointer;

        font-size: 13px;

        font-weight: bold;
    }


    .cancel {

        background: #e5e7eb;

        color: #374151;
    }


    .cancel:hover {

        background: #d1d5db;
    }


    .save {

        background: #2563eb;

        color: white;
    }


    .save:hover {

        background: #1d4ed8;
    }


    /* ================= SUCCESS MESSAGE ================= */

    .success-message {

        display: none;

        margin-bottom: 20px;

        padding: 13px 15px;

        background: #dcfce7;

        color: #166534;

        border: 1px solid #bbf7d0;

        border-radius: 8px;

        font-size: 13px;

        font-weight: bold;
    }


    /* ================= FOOTER ================= */

    footer {

        text-align: center;

        padding: 25px;

        color: #94a3b8;

        font-size: 11px;
    }


    /* ================= MOBILE ================= */

    @media (max-width: 750px) {

        .sidebar {

            width: 70px;

            padding: 20px 8px;
        }


        .logo h2,
        .logo span,
        .menu-title,
        .menu a span {

            display: none;
        }


        .logo {

            justify-content: center;

            padding: 0 0 20px;
        }


        .menu a {

            justify-content: center;
        }


        .main {

            margin-left: 70px;
        }


        .topbar {

            padding: 0 15px;
        }


        .profile-info {

            display: none;
        }


        .content {

            padding: 18px;
        }


        .form-grid {

            grid-template-columns: 1fr;
        }


        .form-group.full {

            grid-column: auto;
        }

    }


    @media (max-width: 500px) {

        .page-header {

            flex-direction: column;

            align-items: flex-start;

            gap: 8px;
        }


        .form-actions {

            flex-direction: column;
        }


        .btn {

            width: 100%;
        }

    }

</style>

</head>

<body>

<!-- ================= SIDEBAR ================= -->

<aside class="sidebar">


    <div class="logo">

        <div class="logo-icon">
            IT
        </div>


        <div>

            <h2>
                IT Asset Manager
            </h2>

            <span>
                Administration System
            </span>

        </div>

    </div>


    <nav class="menu">


        <div class="menu-title">
            Main Menu
        </div>


        <a href="index.html">

            <div class="menu-icon">
                ▣
            </div>

            <span>
                Dashboard
            </span>

        </a>


        <a href="assets.html" class="active">

            <div class="menu-icon">
                ▤
            </div>

            <span>
                Assets
            </span>

        </a>


        <a href="#">

            <div class="menu-icon">
                ♙
            </div>

            <span>
                Employees
            </span>

        </a>


        <a href="#">

            <div class="menu-icon">
                ↔
            </div>

            <span>
                Assignments
            </span>

        </a>


        <a href="#">

            <div class="menu-icon">
                ⚙
            </div>

            <span>
                Maintenance
            </span>

        </a>


        <div
            class="menu-title"
            style="margin-top:25px;"
        >
            Management
        </div>


        <a href="#">

            <div class="menu-icon">
                ▥
            </div>

            <span>
                Reports
            </span>

        </a>


        <a href="#">

            <div class="menu-icon">
                ⚙
            </div>

            <span>
                Settings
            </span>

        </a>


    </nav>

</aside>



<!-- ================= MAIN ================= -->

<main class="main">


    <!-- TOPBAR -->

    <header class="topbar">


        <div>

            <h1>
                IT Administration Dashboard
            </h1>

            <p>
                Asset management and equipment tracking
            </p>

        </div>


        <div class="profile">


            <div class="profile-avatar">
                GT
            </div>


            <div class="profile-info">

                <strong>
                    IT Administrator
                </strong>

                <span>
                    System Administrator
                </span>

            </div>


        </div>


    </header>



    <!-- ================= CONTENT ================= -->

    <section class="content">


        <div class="page-header">


            <div>

                <h2>
                    Add New Asset
                </h2>

                <p>
                    Register a new company IT asset.
                </p>

            </div>


        </div>



        <!-- SUCCESS MESSAGE -->

        <div
            class="success-message"
            id="successMessage"
        >
            ✓ Asset saved successfully!
        </div>



        <!-- FORM -->

        <div class="form-panel">


            <h3 class="form-title">
                Asset Information
            </h3>


            <form id="assetForm">


                <div class="form-grid">


                    <!-- ASSET ID -->

                    <div class="form-group">

                        <label>
                            Asset ID
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="assetId"
                            placeholder="Example: PC-001"
                            required
                        >

                    </div>



                    <!-- EQUIPMENT -->

                    <div class="form-group">

                        <label>
                            Equipment Name
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="equipment"
                            placeholder="Example: Dell OptiPlex 7010"
                            required
                        >

                    </div>



                    <!-- CATEGORY -->

                    <div class="form-group">

                        <label>
                            Category
                            <span class="required">*</span>
                        </label>


                        <select
                            id="category"
                            required
                        >

                            <option value="">
                                Select category
                            </option>

                            <option value="Computer">
                                Computer
                            </option>

                            <option value="Laptop">
                                Laptop
                            </option>

                            <option value="Printer">
                                Printer
                            </option>

                            <option value="Network Equipment">
                                Network Equipment
                            </option>

                            <option value="CCTV">
                                CCTV
                            </option>

                            <option value="Server">
                                Server
                            </option>

                            <option value="UPS">
                                UPS
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>



                    <!-- SERIAL NUMBER -->

                    <div class="form-group">

                        <label>
                            Serial Number
                            <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            id="serialNumber"
                            placeholder="Example: DELL123456"
                            required
                        >

                    </div>



                    <!-- DEPARTMENT -->

                    <div class="form-group">

                        <label>
                            Department
                            <span class="required">*</span>
                        </label>


                        <select
                            id="department"
                            required
                        >

                            <option value="">
                                Select department
                            </option>

                            <option value="IT">
                                IT
                            </option>

                            <option value="Finance">
                                Finance
                            </option>

                            <option value="HR">
                                HR
                            </option>

                            <option value="Production">
                                Production
                            </option>

                            <option value="Purchasing">
                                Purchasing
                            </option>

                            <option value="Quality">
                                Quality
                            </option>

                            <option value="Management">
                                Management
                            </option>

                        </select>

                    </div>



                    <!-- STATUS -->

                    <div class="form-group">

                        <label>
                            Status
                            <span class="required">*</span>
                        </label>


                        <select
                            id="status"
                            required
                        >

                            <option value="">
                                Select status
                            </option>

                            <option value="Available">
                                Available
                            </option>

                            <option value="In Use">
                                In Use
                            </option>

                            <option value="Repair">
                                Repair
                            </option>

                        </select>

                    </div>



                    <!-- LOCATION -->

                    <div class="form-group">

                        <label>
                            Location
                        </label>

                        <input
                            type="text"
                            id="location"
                            placeholder="Example: Factory / Head Office"
                        >

                    </div>



                    <!-- PURCHASE DATE -->

                    <div class="form-group">

                        <label>
                            Purchase Date
                        </label>

                        <input
                            type="date"
                            id="purchaseDate"
                        >

                    </div>



                    <!-- NOTES -->

                    <div class="form-group full">

                        <label>
                            Notes
                        </label>

                        <textarea
                            id="notes"
                            placeholder="Additional information about this asset..."
                        ></textarea>

                    </div>


                </div>



                <!-- BUTTONS -->

                <div class="form-actions">


                    <button
                        type="button"
                        class="btn cancel"
                        onclick="window.location.href='assets.html'"
                    >
                        Cancel
                    </button>


                    <button
                        type="submit"
                        class="btn save"
                    >
                        Save Asset
                    </button>


                </div>


            </form>


        </div>


    </section>



    <!-- FOOTER -->

    <footer>

        IT Asset Management System © 2026 |
        Developed by Getahun Tegene

    </footer>


</main>



<!-- ================= JAVASCRIPT ================= -->

<script>


    document
        .getElementById("assetForm")
        .addEventListener("submit", function(event) {


            event.preventDefault();


            /* GET FORM VALUES */

            const asset = {

                assetId:
                    document.getElementById("assetId").value.trim(),

                equipment:
                    document.getElementById("equipment").value.trim(),

                category:
                    document.getElementById("category").value,

                serialNumber:
                    document.getElementById("serialNumber").value.trim(),

                department:
                    document.getElementById("department").value,

                status:
                    document.getElementById("status").value,

                location:
                    document.getElementById("location").value.trim(),

                purchaseDate:
                    document.getElementById("purchaseDate").value,

                notes:
                    document.getElementById("notes").value.trim()

            };


            /* GET EXISTING ASSETS */

            let assets =
                JSON.parse(
                    localStorage.getItem("assets")
                ) || [];


            /* CHECK DUPLICATE ASSET ID */

            const duplicate =
                assets.some(function(existingAsset) {

                    return existingAsset.assetId.toLowerCase()
                        === asset.assetId.toLowerCase();

                });


            if (duplicate) {

                alert(
                    "This Asset ID already exists. Please use another Asset ID."
                );

                return;

            }


            /* ADD NEW ASSET */

            assets.push(asset);


            /* SAVE TO BROWSER */

            localStorage.setItem(
                "assets",
                JSON.stringify(assets)
            );


            /* SHOW SUCCESS MESSAGE */

            const message =
                document.getElementById("successMessage");

            message.style.display = "block";


            /* CLEAR FORM */

            document.getElementById("assetForm").reset();


            /* GO TO ASSETS PAGE AFTER SHORT DELAY */

            setTimeout(function() {

                window.location.href = "assets.html";

            }, 1200);


        });


</script>

</body>

</html>

